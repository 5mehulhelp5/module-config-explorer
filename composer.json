{
    "name": "brocode/module-config-explorer",
    "description": "Read-only Magento 2 admin grid and REST API over core_config_data. Encrypted values are redacted by default in both; plaintext reveal is REST-only and gated behind a system toggle, an ACL resource, and an explicit request flag.",
    "type": "magento2-module",
    "version": "1.1.0",
    "license": "MIT",
    "homepage": "https://github.com/brosenberger/module-config-explorer",
    "keywords": [
        "magento2",
        "magento",
        "core-config-data",
        "rest-api",
        "security",
        "encryption",
        "admin-grid",
        "brocode"
    ],
    "authors": [
        {
            "name": "Benjamin Rosenberger",
            "email": "bensch.rosenberger@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/brosenberger/module-config-explorer/issues",
        "source": "https://github.com/brosenberger/module-config-explorer"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/brosenberger"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": ">=103.0.0",
        "magento/module-config": ">=101.2.0",
        "magento/module-backend": ">=102.0.0",
        "magento/module-store": ">=101.1.0",
        "magento/module-ui": ">=101.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "BroCode\\ConfigExplorer\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BroCode\\ConfigExplorer\\Test\\Unit\\": "Test/Unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true
        }
    }
}
